# Solana RPC endpoint (required)
# Mainnet options:
#   Helius free tier:  https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   Quicknode:         https://your-endpoint.quiknode.pro/YOUR_KEY/
#   Public (rate-limited, not for production): https://api.mainnet-beta.solana.com
#
# Devnet (for local testing only):
#   VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Network label shown in the UI (mainnet-beta | devnet)
VITE_SOLANA_NETWORK=mainnet-beta

# Log level for AI engine (error | warn | info | debug)
VITE_QVAC_LOG_LEVEL=warn

# USDT (SPL Token) mint address
# Mainnet USDT:  Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
# Devnet USDT:   set to your devnet mint address
VITE_USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
